# Pomelo Android release. chrome_public_apk, arm64, no Google API keys.
# is_official_build stays false: this is still a release build (is_debug = false,
# symbol_level = 0) sized for a free GitHub-hosted runner.

target_os = "android"
target_cpu = "arm64"
is_debug = false
is_component_build = false
is_official_build = false
dcheck_always_on = false

symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

treat_warnings_as_errors = false
use_remoteexec = false
android_static_analysis = "off"
# 64-bit only. The 32-bit secondary toolchain is a large extra compile.
skip_secondary_abi_for_cq = true

# Do not bake Google API keys. An empty key is the public-Chromium default;
# features that call Google services will not work, and that is intentional.
use_official_google_api_keys = false
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""

proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_hevc_parser_and_hw_decoder = true

# Installs beside Chrome (com.android.chrome) and stock Chromium
# (org.chromium.chrome). The visible name is set in channel_constants.xml.
chrome_public_manifest_package = "io.github.hooiv.pomelo"

# Desktop-Android extensions. enable_desktop_android_extensions defaults to
# this flag; set it explicitly so the extensions core is not dropped.
is_desktop_android = true
enable_desktop_android_extensions = true
