+
+struct FilterRule {
+  bool allow = false;
+  std::string host_suffix;
 };
 
+std::string TrimRule(std::string_view raw) {
+  size_t start = 0;
+  while (start < raw.size() &&
+         (raw[start] == ' ' || raw[start] == '\t' || raw[start] == '\r')) {
+    ++start;
+  }
+  size_t end = raw.size();
+  while (end > start &&
+         (raw[end - 1] == ' ' || raw[end - 1] == '\t' || raw[end - 1] == '\r')) {
+    --end;
+  }
+  return std::string(raw.substr(start, end - start));
+}
+
+void ParseFilters(std::string_view text, std::vector<FilterRule>* rules) {
+  size_t pos = 0;
+  while (pos <= text.size()) {
+    size_t next = text.find('\n', pos);
+    std::string_view raw =
+        text.substr(pos, next == std::string_view::npos ? text.size() - pos
+                                                        : next - pos);
+    pos = next == std::string_view::npos ? text.size() + 1 : next + 1;
+    std::string line = TrimRule(raw);
+    if (line.empty() || line[0] == '!' || line[0] == '[') {
+      continue;
+    }
+    FilterRule rule;
+    if (line.starts_with("@@")) {
+      rule.allow = true;
+      line.erase(0, 2);
+    }
+    size_t dollar = line.find('$');
+    if (dollar != std::string::npos) {
+      line.resize(dollar);
+    }
+    if (line.starts_with("||")) {
+      line.erase(0, 2);
+    }
+    size_t caret = line.find('^');
+    if (caret != std::string::npos) {
+      line.resize(caret);
+    }
+    size_t slash = line.find('/');
+    if (slash != std::string::npos) {
+      line.resize(slash);
+    }
+    if (line.empty() || line.find('*') != std::string::npos) {
+      continue;
+    }
+    rule.host_suffix = base::ToLowerASCII(line);
+    rules->push_back(std::move(rule));
+  }
+}
+
+struct FilterSet {
+  base::Lock lock;
+  std::string extra;
+  std::vector<FilterRule> rules;
+};
+
+FilterSet& filter_set() {
+  static base::NoDestructor<FilterSet> set;
+  return *set;
+}
+
+bool HostMatchesSuffix(std::string_view host, std::string_view suffix) {
+  if (host == suffix) {
+    return true;
+  }
+  return host.size() > suffix.size() &&
+         host[host.size() - suffix.size() - 1] == '.' &&
+         host.ends_with(suffix);
+}
+
+bool FiltersBlock(std::string_view host, std::string_view extra) {
+  FilterSet& set = filter_set();
+  base::AutoLock guard(set.lock);
+  if (set.rules.empty() || set.extra != extra) {
+    set.extra = std::string(extra);
+    set.rules.clear();
+    ParseFilters(kBuiltinFilters, &set.rules);
+    ParseFilters(extra, &set.rules);
+  }
+  bool block = false;
+  for (const FilterRule& rule : set.rules) {
+    if (!HostMatchesSuffix(host, rule.host_suffix)) {
+      continue;
+    }
+    if (rule.allow) {
+      return false;
+    }
+    block = true;
+  }
+  return block;
+}
