+static void JNI_ContentUtils_SetPomeloCustomUserAgent(
+    JNIEnv* env,
+    const base::android::JavaRef<jobject>& jweb_contents,
+    const std::string& user_agent) {
+  content::WebContents* web_contents =
+      content::WebContents::FromJavaWebContents(jweb_contents);
+  if (!web_contents) {
+    return;
+  }
+  blink::UserAgentOverride override_value;
+  if (!user_agent.empty()) {
+    override_value.ua_string_override = user_agent;
+  }
+  web_contents->SetUserAgentOverride(override_value, /*override_in_new_tabs=*/false);
+}
+
 static void JNI_ContentUtils_SetPomeloAdBlockEnabled(JNIEnv* env, bool enabled) {
   pomelo::SetAdBlockEnabled(enabled);
 }
