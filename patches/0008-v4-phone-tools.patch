+package org.chromium.chrome.browser.pomelo;
+
+import android.content.SharedPreferences;
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.content.ContentUtils;
+import org.chromium.chrome.browser.desktop_site.DesktopSiteUtils;
+import org.chromium.chrome.browser.dom_distiller.DomDistillerServiceFactory;
+import org.chromium.chrome.browser.dom_distiller.ReaderModeManager;
+import org.chromium.chrome.browser.preferences.Pref;
+import org.chromium.chrome.browser.printing.PrintHelper;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tabmodel.TabCreatorUtil;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.chrome.browser.translate.TranslateBridge;
+import org.chromium.components.dom_distiller.core.DistilledPagePrefs;
+import org.chromium.components.user_prefs.UserPrefs;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.url.GURL;
+
+/** Extra phone tools that use APIs already in this Chromium tree. */
+@NullMarked
+public class PomeloMore {
+    private static final String KEY_PIN = "pomelo_incognito_pin";
+    private static final String KEY_UA = "pomelo_user_agent";
+    static final String KEY_FILTERS = "pomelo_filter_rules";
+    private static boolean sIncognitoUnlocked;
+
+    private PomeloMore() {}
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+
+    public static boolean handleMenuAction(ChromeActivity activity, int id) {
+        Tab tab = activity.getActivityTab();
+        if (id == R.id.pomelo_desktop_site) {
+            toggleDesktopSite(activity, tab);
+            return true;
+        }
+        if (id == R.id.pomelo_reader) {
+            tweakReader(activity, tab);
+            return true;
+        }
+        if (id == R.id.pomelo_translate) {
+            if (tab != null) TranslateBridge.translateTabWhenReady(tab);
+            return true;
+        }
+        if (id == R.id.pomelo_save_pdf) {
+            if (!PrintHelper.printTab(tab)) toast(activity, "Can't print this page");
+            return true;
+        }
+        if (id == R.id.pomelo_force_zoom) {
+            toggleForceZoom(activity, tab);
+            return true;
+        }
+        if (id == R.id.pomelo_user_agent) {
+            editUserAgent(activity, tab);
+            return true;
+        }
+        if (id == R.id.pomelo_navigate_back) {
+            if (tab != null && tab.canGoBack()) tab.goBack();
+            return true;
+        }
+        if (id == R.id.pomelo_navigate_forward) {
+            if (tab != null && tab.canGoForward()) tab.goForward();
+            return true;
+        }
+        if (id == R.id.pomelo_tab_group) {
+            groupWithNeighbor(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_incognito_lock) {
+            editIncognitoPin(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_filters) {
+            editFilters(activity);
+            return true;
+        }
+        return false;
+    }
+
+    /** @return true when opening Incognito should wait for the PIN dialog. */
+    public static boolean guardIncognito(ChromeActivity activity) {
+        String pin = prefs().getString(KEY_PIN, "");
+        if (pin == null || pin.isEmpty() || sIncognitoUnlocked) return false;
+        EditText input = new EditText(activity);
+        input.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        new AlertDialog.Builder(activity)
+                .setTitle("Incognito lock")
+                .setView(input)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            if (pin.equals(input.getText().toString())) {
+                                sIncognitoUnlocked = true;
+                                TabCreatorUtil.launchNtp(activity.getTabCreator(true));
+                            } else {
+                                toast(activity, "Wrong PIN");
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+        return true;
+    }
+
+    public static void applyCustomUserAgent(@Nullable Tab tab) {
+        if (tab == null) return;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        String ua = prefs().getString(KEY_UA, "");
+        ContentUtils.setPomeloCustomUserAgent(webContents, ua == null ? "" : ua);
+    }
+
+    private static void toggleDesktopSite(ChromeActivity activity, @Nullable Tab tab) {
+        if (tab == null) return;
+        Profile profile = tab.getProfile();
+        GURL url = tab.getUrl();
+        boolean next = !prefs().getBoolean("pomelo_desktop_" + url.getHost(), false);
+        DesktopSiteUtils.setRequestDesktopSiteContentSettingsForUrl(profile, url, next);
+        prefs().edit().putBoolean("pomelo_desktop_" + url.getHost(), next).apply();
+        tab.reload();
+        toast(activity, next ? "Desktop site for this host" : "Mobile site for this host");
+    }
+
+    private static void tweakReader(ChromeActivity activity, @Nullable Tab tab) {
+        if (tab == null) return;
+        DistilledPagePrefs prefs =
+                DomDistillerServiceFactory.getForProfile(tab.getProfile()).getDistilledPagePrefs();
+        float next = prefs.getFontScaling() < 1.3f ? 1.45f : 1.0f;
+        prefs.setFontScaling(next);
+        ReaderModeManager manager =
+                tab.getUserDataHost().getUserData(ReaderModeManager.class);
+        if (manager != null) {
+            manager.activateReaderMode(ReaderModeManager.EntryPoint.APP_MENU);
+        }
+        toast(activity, next > 1.2f ? "Reader text larger" : "Reader text normal");
+    }
+
+    private static void toggleForceZoom(ChromeActivity activity, @Nullable Tab tab) {
+        if (tab == null) return;
+        var service = UserPrefs.get(tab.getProfile());
+        boolean next = !service.getBoolean(Pref.ACCESSIBILITY_FORCE_ENABLE_ZOOM);
+        service.setBoolean(Pref.ACCESSIBILITY_FORCE_ENABLE_ZOOM, next);
+        toast(activity, next ? "Force zoom on" : "Force zoom off");
+    }
+
+    private static void editUserAgent(ChromeActivity activity, @Nullable Tab tab) {
+        EditText input = new EditText(activity);
+        input.setSingleLine(true);
+        input.setHint("Empty uses the normal Pomelo agent");
+        String saved = prefs().getString(KEY_UA, "");
+        input.setText(saved == null ? "" : saved);
+        new AlertDialog.Builder(activity)
+                .setTitle("User agent")
+                .setView(input)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            prefs().edit().putString(KEY_UA, input.getText().toString().trim()).apply();
+                            applyCustomUserAgent(tab);
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void groupWithNeighbor(ChromeActivity activity) {
+        TabModel model = activity.getCurrentTabModel();
+        int index = model.index();
+        if (index < 0 || model.getCount() < 2) {
+            toast(activity, "Need two tabs to make a group");
+            return;
+        }
+        Tab current = model.getTabAt(index);
+        int otherIndex = index + 1 < model.getCount() ? index + 1 : index - 1;
+        Tab other = model.getTabAt(otherIndex);
+        if (current == null || other == null) return;
+        model.mergeTabsToGroup(other.getId(), current.getId());
+        toast(activity, "Tabs grouped");
+    }
+
+    private static void editIncognitoPin(ChromeActivity activity) {
+        EditText input = new EditText(activity);
+        input.setInputType(InputType.TYPE_CLASS_NUMBER | InputType.TYPE_NUMBER_VARIATION_PASSWORD);
+        input.setHint("Empty removes the lock");
+        new AlertDialog.Builder(activity)
+                .setTitle("Incognito PIN")
+                .setView(input)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            prefs().edit().putString(KEY_PIN, input.getText().toString().trim()).apply();
+                            sIncognitoUnlocked = false;
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void editFilters(ChromeActivity activity) {
+        EditText input = new EditText(activity);
+        input.setMinLines(8);
+        input.setHint("||ads.example^ or @@||ads.example^");
+        String saved = prefs().getString(KEY_FILTERS, "");
+        input.setText(saved == null ? "" : saved);
+        new AlertDialog.Builder(activity)
+                .setTitle("Filter lists")
+                .setMessage(
+                        "Extra network filters in EasyList / uBlock syntax. The built-in starter"
+                                + " list stays. EasyList itself is not bundled.")
+                .setView(input)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) ->
+                                prefs().edit()
+                                        .putString(KEY_FILTERS, input.getText().toString())
+                                        .apply())
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void toast(ChromeActivity activity, String message) {
+        Toast.makeText(activity, message, Toast.LENGTH_SHORT).show();
+    }
+}
