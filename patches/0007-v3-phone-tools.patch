+void ApplySyncUrlSwitch() {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  std::string url = Java_ContentUtils_getPomeloSyncUrl(env);
+  if (url.empty()) {
+    return;
+  }
+  base::CommandLine* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("sync-url")) {
+    command_line->AppendSwitchASCII("sync-url", url);
+  }
+}
+
 }  // namespace pomelo
