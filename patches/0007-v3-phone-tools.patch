+++ bb/chrome/android/java/src/org/chromium/chrome/browser/pomelo/PomeloDesk.java
@@ -0,0 +1,207 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+package org.chromium.chrome.browser.pomelo;
+
+import android.content.SharedPreferences;
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.tab.TabLaunchType;
+import org.chromium.chrome.browser.tabmodel.TabCreator;
+import org.chromium.chrome.browser.tabmodel.TabModel;
+import org.chromium.content_public.browser.LoadUrlParams;
+import org.chromium.ui.base.PageTransition;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/** Notes, named tab sessions, and a custom sync server URL. */
+@NullMarked
+public class PomeloDesk {
+    private static final String KEY_NOTES = "pomelo_notes";
+    private static final String KEY_SESSIONS = "pomelo_sessions";
+    static final String KEY_SYNC_URL = "pomelo_sync_url";
+
+    private PomeloDesk() {}
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+
+    public static boolean handleMenuAction(ChromeActivity activity, int id) {
+        if (id == R.id.pomelo_notes) {
+            showNotes(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_sessions) {
+            showSessions(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_sync_server) {
+            showSyncServer(activity);
+            return true;
+        }
+        return false;
+    }
+
+    private static void showNotes(ChromeActivity activity) {
+        EditText text = new EditText(activity);
+        text.setMinLines(8);
+        text.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
+        String saved = prefs().getString(KEY_NOTES, "");
+        text.setText(saved == null ? "" : saved);
+        new AlertDialog.Builder(activity)
+                .setTitle("Notes")
+                .setView(text)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) ->
+                                prefs().edit().putString(KEY_NOTES, text.getText().toString()).apply())
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void showSessions(ChromeActivity activity) {
+        JSONArray sessions = readSessions();
+        String[] labels = new String[sessions.length() + 1];
+        labels[0] = "Save open tabs";
+        for (int i = 0; i < sessions.length(); i++) {
+            JSONObject session = sessions.optJSONObject(i);
+            labels[i + 1] = session == null ? "session" : session.optString("name", "session");
+        }
+        new AlertDialog.Builder(activity)
+                .setTitle("Sessions")
+                .setItems(
+                        labels,
+                        (dialog, which) -> {
+                            if (which == 0) {
+                                saveSession(activity, sessions);
+                            } else {
+                                restoreOrDelete(activity, sessions, which - 1);
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void saveSession(ChromeActivity activity, JSONArray sessions) {
+        TabModel model = activity.getCurrentTabModel();
+        JSONArray urls = new JSONArray();
+        for (int i = 0; i < model.getCount(); i++) {
+            Tab tab = model.getTabAt(i);
+            if (tab == null) continue;
+            String spec = tab.getUrl().getSpec();
+            if (!spec.isEmpty()) urls.put(spec);
+        }
+        if (urls.length() == 0) {
+            toast(activity, "No tabs to save");
+            return;
+        }
+        EditText name = new EditText(activity);
+        name.setHint("Session name");
+        name.setSingleLine(true);
+        new AlertDialog.Builder(activity)
+                .setTitle("Save session")
+                .setView(name)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            JSONObject session = new JSONObject();
+                            try {
+                                String title = name.getText().toString().trim();
+                                session.put("name", title.isEmpty() ? "Session" : title);
+                                session.put("urls", urls);
+                                sessions.put(session);
+                            } catch (JSONException ignored) {
+                                return;
+                            }
+                            writeSessions(sessions);
+                            toast(activity, "Session saved");
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void restoreOrDelete(ChromeActivity activity, JSONArray sessions, int index) {
+        JSONObject session = sessions.optJSONObject(index);
+        if (session == null) return;
+        new AlertDialog.Builder(activity)
+                .setTitle(session.optString("name", "Session"))
+                .setPositiveButton(
+                        "Open",
+                        (dialog, which) -> {
+                            JSONArray urls = session.optJSONArray("urls");
+                            if (urls == null) return;
+                            TabCreator creator =
+                                    activity.getTabCreator(activity.getCurrentTabModel().isIncognito());
+                            for (int i = 0; i < urls.length(); i++) {
+                                String url = urls.optString(i, "");
+                                if (url.isEmpty()) continue;
+                                creator.createNewTab(
+                                        new LoadUrlParams(url, PageTransition.AUTO_TOPLEVEL),
+                                        TabLaunchType.FROM_CHROME_UI,
+                                        /* parent= */ null);
+                            }
+                        })
+                .setNeutralButton(
+                        "Delete",
+                        (dialog, which) -> {
+                            sessions.remove(index);
+                            writeSessions(sessions);
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void showSyncServer(ChromeActivity activity) {
+        EditText url = new EditText(activity);
+        url.setHint("https://example.com/chromiumsync");
+        url.setSingleLine(true);
+        String saved = prefs().getString(KEY_SYNC_URL, "");
+        url.setText(saved == null ? "" : saved);
+        new AlertDialog.Builder(activity)
+                .setTitle("Sync server")
+                .setMessage(
+                        "Optional Chromium sync server. Leave empty to keep the default. Takes"
+                                + " effect on the next start. This does not sign you in; it only"
+                                + " changes where an already signed-in profile syncs.")
+                .setView(url)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) ->
+                                prefs().edit()
+                                        .putString(KEY_SYNC_URL, url.getText().toString().trim())
+                                        .apply())
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static JSONArray readSessions() {
+        String raw = prefs().getString(KEY_SESSIONS, "[]");
+        if (raw == null) raw = "[]";
+        try {
+            return new JSONArray(raw);
+        } catch (JSONException e) {
+            return new JSONArray();
+        }
+    }
+
+    private static void writeSessions(JSONArray sessions) {
+        prefs().edit().putString(KEY_SESSIONS, sessions.toString()).apply();
+    }
+
+    private static void toast(ChromeActivity activity, String message) {
+        Toast.makeText(activity, message, Toast.LENGTH_SHORT).show();
+    }
+}
