 #include "third_party/jni_zero/jni_zero.h"
 
 #if BUILDFLAG(ENABLE_DEVTOOLS_FRONTEND)
 #include "chrome/browser/devtools/devtools_window.h"
 #endif  // BUILDFLAG(ENABLE_DEVTOOLS_FRONTEND)
 
+#if BUILDFLAG(ENABLE_DEVTOOLS_FRONTEND)
+void ApplyPomeloPhoneViewport(base::WeakPtr<content::WebContents> inspected) {
+  if (!inspected) {
+    return;
+  }
+  scoped_refptr<content::DevToolsAgentHost> host =
+      content::DevToolsAgentHost::GetOrCreateForTab(inspected.get());
+  if (!host) {
+    return;
+  }
+  DevToolsWindow* window = DevToolsWindow::FindDevToolsWindow(host.get());
+  if (!window) {
+    return;
+  }
+  content::WebContents* frontend = window->GetDevToolsWebContents();
+  if (!frontend) {
+    return;
+  }
+  content::RenderFrameHost* frame = frontend->GetPrimaryMainFrame();
+  if (!frame || !frame->IsRenderFrameLive()) {
+    return;
+  }
+  // The bundled frontend is a desktop layout. A viewport meta lets a phone
+  // scale it instead of laying it out at a desktop width.
+  frame->ExecuteJavaScript(
+      uR"JS((()=>{const d=document;if(!d||!d.head)return;if(d.querySelector('meta[name="viewport"][data-pomelo]'))return;const m=d.createElement('meta');m.name='viewport';m.setAttribute('data-pomelo','1');m.content='width=device-width,initial-scale=1,minimum-scale=0.25';d.head.appendChild(m);})())JS",
+      base::NullCallback());
+}
+
+void SchedulePomeloPhoneViewport(content::WebContents* inspected) {
+  if (!inspected) {
+    return;
+  }
+  base::WeakPtr<content::WebContents> weak = inspected->GetWeakPtr();
+  for (int delay_ms : {0, 300, 1200}) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE, base::BindOnce(&ApplyPomeloPhoneViewport, weak),
+        base::Milliseconds(delay_ms));
+  }
+}
+#endif  // BUILDFLAG(ENABLE_DEVTOOLS_FRONTEND)
