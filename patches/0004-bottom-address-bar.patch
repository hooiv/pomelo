Pomelo: address bar on the bottom by default.

Chromium 158 calls this AndroidBottomBar (kAndroidBottomBar), not
kAndroidBottomToolbar. The feature is enabled, the cached flag matches, and
the unset address-bar preference is BOTTOM_SETTINGS. Settings still offers
top and bottom.

diff --git a/chrome/browser/flags/android/chrome_feature_list.cc b/chrome/browser/flags/android/chrome_feature_list.cc
index ed9b009..fb19408 100644
--- a/chrome/browser/flags/android/chrome_feature_list.cc
+++ b/chrome/browser/flags/android/chrome_feature_list.cc
@@ -683,7 +683,7 @@ BASE_FEATURE(kAndroidAutoProjected, base::FEATURE_DISABLED_BY_DEFAULT);
 BASE_FEATURE(kAndroidAutofillPrefObserver, base::FEATURE_DISABLED_BY_DEFAULT);
