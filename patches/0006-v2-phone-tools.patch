diff --git ab/chrome/browser/android/pomelo/pomelo_request_throttle.cc bb/chrome/browser/android/pomelo/pomelo_request_throttle.cc
new file mode 100644
index 0000000000..766cb26b1c
--- /dev/null
+++ bb/chrome/browser/android/pomelo/pomelo_request_throttle.cc
@@ -0,0 +1,203 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/android/pomelo/pomelo_request_throttle.h"
+
+#include <atomic>
+#include <deque>
+#include <string>
+#include <string_view>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/strings/string_util.h"
+#include "base/synchronization/lock.h"
+#include "net/base/net_errors.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+#include "url/gurl.h"
+
+namespace pomelo {
+namespace {
+
+constexpr std::string_view kAdHosts[] = {
+    "doubleclick.net",
+    "googlesyndication.com",
+    "googleadservices.com",
+    "googletagservices.com",
+    "adnxs.com",
+    "adsrvr.org",
+    "rubiconproject.com",
+    "pubmatic.com",
+    "openx.net",
+    "criteo.com",
+    "criteo.net",
+    "taboola.com",
+    "outbrain.com",
+    "scorecardresearch.com",
+    "amazon-adsystem.com",
+    "moatads.com",
+    "adsafeprotected.com",
+    "serving-sys.com",
+    "2mdn.net",
+    "adform.net",
+    "smartadserver.com",
+    "media.net",
+    "casalemedia.com",
+    "sharethrough.com",
+    "yieldmo.com",
+    "bidswitch.net",
+    "contextweb.com",
+    "ads.yahoo.com",
+};
+
+constexpr size_t kMaxMediaUrls = 40;
+
+struct MediaLog {
+  base::Lock lock;
+  std::deque<std::string> urls;
+};
+
+MediaLog& media_log() {
+  static base::NoDestructor<MediaLog> log;
+  return *log;
+}
+
+std::atomic<bool>& adblock_enabled() {
+  static std::atomic<bool> enabled{true};
+  return enabled;
+}
+
+bool HostIsListed(std::string_view host) {
+  for (std::string_view suffix : kAdHosts) {
+    if (host == suffix) {
+      return true;
+    }
+    if (host.size() > suffix.size() &&
+        host[host.size() - suffix.size() - 1] == '.' &&
+        host.ends_with(suffix)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+bool LooksLikeMedia(const GURL& url,
+                    network::mojom::RequestDestination destination,
+                    std::string_view mime) {
+  if (destination == network::mojom::RequestDestination::kVideo ||
+      destination == network::mojom::RequestDestination::kAudio) {
+    return true;
+  }
+  if (base::StartsWith(mime, "video/") || base::StartsWith(mime, "audio/") ||
+      mime == "application/vnd.apple.mpegurl" ||
+      mime == "application/x-mpegurl") {
+    return true;
+  }
+  std::string path = base::ToLowerASCII(url.path());
+  return path.ends_with(".mp4") || path.ends_with(".m4v") ||
+         path.ends_with(".webm") || path.ends_with(".mkv") ||
+         path.ends_with(".m3u8") || path.ends_with(".mpd") ||
+         path.ends_with(".mp3") || path.ends_with(".m4a") ||
+         path.ends_with(".aac") || path.ends_with(".ogg") ||
+         path.ends_with(".opus");
+}
+
+void RememberMedia(const GURL& url) {
+  if (!url.SchemeIsHTTPOrHTTPS()) {
+    return;
+  }
+  const std::string spec = url.spec();
+  MediaLog& log = media_log();
+  base::AutoLock guard(log.lock);
+  for (const std::string& existing : log.urls) {
+    if (existing == spec) {
+      return;
+    }
+  }
+  log.urls.push_back(spec);
+  while (log.urls.size() > kMaxMediaUrls) {
+    log.urls.pop_front();
+  }
+}
+
+class PomeloRequestThrottle : public blink::URLLoaderThrottle {
+ public:
+  PomeloRequestThrottle() = default;
+  PomeloRequestThrottle(const PomeloRequestThrottle&) = delete;
+  PomeloRequestThrottle& operator=(const PomeloRequestThrottle&) = delete;
+  ~PomeloRequestThrottle() override = default;
+
+  void WillStartRequest(network::ResourceRequest* request,
+                        bool* defer) override {
+    is_main_frame_ = request->is_outermost_main_frame;
+    Consider(request->url, request->destination, std::string_view());
+  }
+
+  void WillRedirectRequest(
+      net::RedirectInfo* redirect_info,
+      const network::mojom::URLResponseHead& response_head,
+      bool* defer,
+      network::HttpRequestHeadersUpdateParams* headers_update_params)
+      override {
+    Consider(redirect_info->new_url, network::mojom::RequestDestination::kEmpty,
+             response_head.mime_type);
+  }
+
+  void WillProcessResponse(const GURL& response_url,
+                           network::mojom::URLResponseHead* response_head,
+                           bool* defer) override {
+    Consider(response_url, network::mojom::RequestDestination::kEmpty,
+             response_head->mime_type);
+  }
+
+ private:
+  void Consider(const GURL& url,
+                network::mojom::RequestDestination destination,
+                std::string_view mime) {
+    if (LooksLikeMedia(url, destination, mime)) {
+      RememberMedia(url);
+    }
+    if (is_main_frame_ || !adblock_enabled().load()) {
+      return;
+    }
+    if (!url.SchemeIsHTTPOrHTTPS()) {
+      return;
+    }
+    if (HostIsListed(url.host()) && delegate_) {
+      delegate_->CancelWithError(net::ERR_BLOCKED_BY_CLIENT, "pomelo-adblock");
+    }
+  }
+
+  bool is_main_frame_ = false;
+};
+
+}  // namespace
+
+void SetAdBlockEnabled(bool enabled) {
+  adblock_enabled().store(enabled);
+}
+
+bool IsAdBlockEnabled() {
+  return adblock_enabled().load();
+}
+
+std::string GetMediaUrls() {
+  MediaLog& log = media_log();
+  base::AutoLock guard(log.lock);
+  std::string joined;
+  for (const std::string& url : log.urls) {
+    if (!joined.empty()) {
+      joined.push_back('\n');
+    }
+    joined.append(url);
+  }
+  return joined;
+}
+
+std::unique_ptr<blink::URLLoaderThrottle> CreateRequestThrottle() {
+  return std::make_unique<PomeloRequestThrottle>();
+}
+
+}  // namespace pomelo
