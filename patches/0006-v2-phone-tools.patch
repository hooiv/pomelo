+package org.chromium.chrome.browser.pomelo;
+
+import android.app.DownloadManager;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.content.res.Resources;
+import android.net.Uri;
+import android.text.InputType;
+import android.view.KeyEvent;
+import android.widget.CheckBox;
+import android.widget.EditText;
+import android.widget.LinearLayout;
+import android.widget.Toast;
+
+import androidx.appcompat.app.AlertDialog;
+
+import org.chromium.base.ContextUtils;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.R;
+import org.chromium.chrome.browser.app.ChromeActivity;
+import org.chromium.chrome.browser.app.appmenu.AppMenuItemTheme;
+import org.chromium.chrome.browser.app.appmenu.AppMenuItemUtils;
+import org.chromium.chrome.browser.content.ContentUtils;
+import org.chromium.chrome.browser.tab.Tab;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuItemProperties;
+import org.chromium.chrome.browser.ui.appmenu.AppMenuItemWithSubmenuProperties;
+import org.chromium.content_public.browser.JavaScriptCallback;
+import org.chromium.content_public.browser.RenderFrameHost;
+import org.chromium.content_public.browser.WebContents;
+import org.chromium.ui.modelutil.MVCListAdapter.ListItem;
+import org.chromium.ui.modelutil.MVCListAdapter.ModelList;
+import org.chromium.ui.modelutil.PropertyModel;
+import org.chromium.url.GURL;
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.HashSet;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Set;
+import java.util.function.Supplier;
+
+/**
+ * Phone tools that are not in stock Chrome: volume-key scrolling, a hideable overflow menu,
+ * picture-in-picture for the current video, a media sniffer, a small built-in ad blocker, and a
+ * userscript runner. Userscript extensions such as Tampermonkey keep working through the desktop
+ * extension support landed in v1; this class also runs scripts saved in the browser itself.
+ */
+@NullMarked
+public class PomeloTools {
+    private static final String KEY_VOLUME = "volume_scroll";
+    private static final String KEY_ADBLOCK = "ad_block";
+    private static final String KEY_HIDDEN = "hidden_menu_ids";
+    private static final String KEY_SCRIPTS = "userscripts";
+    private static final int ISOLATED_WORLD_MAIN = 0;
+    private static final int SCROLL_PX = 280;
+
+    private PomeloTools() {}
+
+    private static SharedPreferences prefs() {
+        return ContextUtils.getAppSharedPreferences();
+    }
+
+    public static void syncNativeFromPrefs() {
+        ContentUtils.setPomeloAdBlockEnabled(prefs().getBoolean(KEY_ADBLOCK, true));
+    }
+
+    public static boolean handleVolumeKey(ChromeActivity activity, KeyEvent event) {
+        if (!prefs().getBoolean(KEY_VOLUME, true)) return false;
+        int key = event.getKeyCode();
+        if (key != KeyEvent.KEYCODE_VOLUME_DOWN && key != KeyEvent.KEYCODE_VOLUME_UP) {
+            return false;
+        }
+        if (event.getAction() != KeyEvent.ACTION_DOWN) return true;
+        if (activity.isInPictureInPictureMode()) return false;
+        Tab tab = activity.getActivityTab();
+        if (tab == null) return false;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null || webContents.isFocusedElementEditable()) return false;
+        if (webContents.isFullscreenForCurrentTab()) return false;
+        int dy = key == KeyEvent.KEYCODE_VOLUME_DOWN ? SCROLL_PX : -SCROLL_PX;
+        if (event.getRepeatCount() > 0) dy *= 2;
+        runOnPage(webContents, "window.scrollBy(0," + dy + ");", null);
+        return true;
+    }
+
+    public static boolean handleMenuAction(ChromeActivity activity, int id) {
+        if (id == R.id.pomelo_float_video) {
+            floatVideo(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_media) {
+            showMedia(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_ad_block) {
+            boolean enabled = !prefs().getBoolean(KEY_ADBLOCK, true);
+            prefs().edit().putBoolean(KEY_ADBLOCK, enabled).apply();
+            if (activity.didFinishNativeInitialization()) {
+                ContentUtils.setPomeloAdBlockEnabled(enabled);
+            }
+            toast(activity, enabled ? "Ad blocker on" : "Ad blocker off");
+            return true;
+        }
+        if (id == R.id.pomelo_volume_scroll) {
+            boolean enabled = !prefs().getBoolean(KEY_VOLUME, true);
+            prefs().edit().putBoolean(KEY_VOLUME, enabled).apply();
+            toast(activity, enabled ? "Volume keys scroll the page" : "Volume keys change volume");
+            return true;
+        }
+        if (id == R.id.pomelo_userscripts) {
+            showUserscripts(activity);
+            return true;
+        }
+        if (id == R.id.pomelo_customize_menu) {
+            showCustomizeMenu(activity);
+            return true;
+        }
+        return false;
+    }
+
+    public static void onPageLoadFinished(Tab tab) {
+        GURL url = tab.getUrl();
+        String scheme = url.getScheme();
+        if (!"http".equals(scheme) && !"https".equals(scheme)) return;
+        WebContents webContents = tab.getWebContents();
+        if (webContents == null) return;
+        String code = enabledUserscriptSource();
+        if (code.isEmpty()) return;
+        runOnPage(webContents, code, null);
+    }
+
+    public static ListItem standardItem(
+            Context context, AppMenuItemTheme theme, int id, int titleId, boolean iconAtStart) {
+        return AppMenuItemUtils.createStandardListItem(
+                AppMenuItemUtils.buildModelForStandardMenuItem(
+                        context, theme, id, titleId, Resources.ID_NULL, iconAtStart),
+                /* showIcon= */ false);
+    }
+
+    public static void retitle(ListItem item, String title) {
+        item.model.set(AppMenuItemProperties.TITLE, title);
+    }
+
+    public static String adBlockTitle() {
+        return prefs().getBoolean(KEY_ADBLOCK, true) ? "Ad blocker: on" : "Ad blocker: off";
+    }
+
+    public static String volumeTitle() {
+        return prefs().getBoolean(KEY_VOLUME, true)
+                ? "Volume keys: scroll"
+                : "Volume keys: volume";
+    }
+
+    /** Drops overflow entries the user hid, including one level of submenu. */
+    public static void filterMenu(ModelList modelList) {
+        Set<String> hidden = hiddenIds();
+        for (int i = modelList.size() - 1; i >= 0; --i) {
+            ListItem item = modelList.get(i);
+            wrapSubmenu(item, hidden);
+            if (shouldHide(item.model, hidden)) modelList.remove(item);
+        }
+    }
+
+    private static void wrapSubmenu(ListItem item, Set<String> hidden) {
+        PropertyModel model = item.model;
+        if (!model.containsKey(AppMenuItemWithSubmenuProperties.SUBMENU_PROVIDER)) return;
+        Supplier<List<ListItem>> original =
+                model.get(AppMenuItemWithSubmenuProperties.SUBMENU_PROVIDER);
+        model.set(
+                AppMenuItemWithSubmenuProperties.SUBMENU_PROVIDER,
+                () -> {
+                    List<ListItem> built = original.get();
+                    List<ListItem> kept = new ArrayList<>();
+                    for (ListItem child : built) {
+                        if (!shouldHide(child.model, hidden)) kept.add(child);
+                    }
+                    return kept;
+                });
+    }
+
+    private static boolean shouldHide(PropertyModel model, Set<String> hidden) {
+        if (!model.containsKey(AppMenuItemProperties.MENU_ITEM_ID)) return false;
+        int id = model.get(AppMenuItemProperties.MENU_ITEM_ID);
+        if (id == R.id.pomelo_customize_menu) return false;
+        return hidden.contains(Integer.toString(id));
+    }
+
+    private static void floatVideo(ChromeActivity activity) {
+        WebContents webContents = currentWebContents(activity);
+        if (webContents == null) {
+            toast(activity, "No page to float");
+            return;
+        }
+        runOnPage(
+                webContents,
+                "(function(){"
+                        + "var vids=[].slice.call(document.querySelectorAll('video'));"
+                        + "var v=vids.filter(function(x){return !x.paused && x.readyState>0;})[0]"
+                        + "||vids.filter(function(x){return x.readyState>0;})[0]||vids[0];"
+                        + "if(!v) return 'none';"
+                        + "if(document.pictureInPictureElement){document.exitPictureInPicture();return 'exit';}"
+                        + "var p=v.requestPictureInPicture();"
+                        + "if(p&&p.catch) p.catch(function(){});"
+                        + "return 'ok';"
+                        + "})()",
+                json -> {
+                    if ("\"none\"".equals(json)) toast(activity, "No video on this page");
+                });
+    }
+
+    private static void showMedia(ChromeActivity activity) {
+        WebContents webContents = currentWebContents(activity);
+        LinkedHashSet<String> urls = new LinkedHashSet<>();
+        if (activity.didFinishNativeInitialization()) {
+            addLines(urls, ContentUtils.getPomeloMediaUrls());
+        }
+        if (webContents == null) {
+            presentMedia(activity, urls);
+            return;
+        }
+        runOnPage(
+                webContents,
+                "(function(){var out=[];function add(u){if(u&&typeof u==='string'&&u.indexOf('http')===0)out.push(u);}"
+                        + "var nodes=document.querySelectorAll('video,audio,source');"
+                        + "for(var i=0;i<nodes.length;i++){add(nodes[i].currentSrc||nodes[i].src);}"
+                        + "var entries=performance.getEntriesByType('resource');"
+                        + "for(var j=0;j<entries.length;j++){var n=entries[j].name||'';"
+                        + "if(/\\.(mp4|m4v|webm|mkv|m3u8|mpd|mp3|m4a|aac|ogg|opus)(\\?|$)/i.test(n))add(n);}"
+                        + "return out;})()",
+                json -> {
+                    if (json != null) {
+                        try {
+                            JSONArray array = new JSONArray(json);
+                            for (int i = 0; i < array.length(); i++) {
+                                urls.add(array.getString(i));
+                            }
+                        } catch (JSONException ignored) {
+                        }
+                    }
+                    presentMedia(activity, urls);
+                });
+    }
+
+    private static void presentMedia(ChromeActivity activity, LinkedHashSet<String> urls) {
+        if (urls.isEmpty()) {
+            toast(activity, "No media spotted on this page yet");
+            return;
+        }
+        String[] items = urls.toArray(new String[0]);
+        new AlertDialog.Builder(activity)
+                .setTitle("Media on this page")
+                .setItems(items, (dialog, which) -> download(activity, items[which]))
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void download(ChromeActivity activity, String url) {
+        try {
+            DownloadManager manager =
+                    (DownloadManager) activity.getSystemService(Context.DOWNLOAD_SERVICE);
+            if (manager == null) {
+                toast(activity, "Download manager is unavailable");
+                return;
+            }
+            DownloadManager.Request request = new DownloadManager.Request(Uri.parse(url));
+            request.setNotificationVisibility(
+                    DownloadManager.Request.VISIBILITY_VISIBLE_NOTIFY_COMPLETED);
+            String name = Uri.parse(url).getLastPathSegment();
+            if (name == null || name.isEmpty()) name = "media";
+            request.setTitle(name);
+            manager.enqueue(request);
+            toast(activity, "Download started");
+        } catch (RuntimeException e) {
+            toast(activity, "Could not download that address");
+        }
+    }
+
+    private static void showUserscripts(ChromeActivity activity) {
+        JSONArray scripts = readScripts();
+        String[] labels = new String[scripts.length() + 1];
+        labels[0] = "Add script";
+        for (int i = 0; i < scripts.length(); i++) {
+            JSONObject script = scripts.optJSONObject(i);
+            String name = script == null ? "script" : script.optString("name", "script");
+            boolean enabled = script != null && script.optBoolean("enabled", true);
+            labels[i + 1] = (enabled ? "" : "(off) ") + name;
+        }
+        new AlertDialog.Builder(activity)
+                .setTitle("Userscripts")
+                .setItems(
+                        labels,
+                        (dialog, which) -> {
+                            if (which == 0) {
+                                editScript(activity, scripts, -1);
+                            } else {
+                                editScript(activity, scripts, which - 1);
+                            }
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static void editScript(ChromeActivity activity, JSONArray scripts, int index) {
+        JSONObject existing = index >= 0 ? scripts.optJSONObject(index) : null;
+        EditText name = new EditText(activity);
+        name.setHint("Name");
+        name.setSingleLine(true);
+        name.setText(existing == null ? "" : existing.optString("name", ""));
+        EditText code = new EditText(activity);
+        code.setHint("JavaScript. Runs on http(s) pages after load.");
+        code.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE);
+        code.setMinLines(6);
+        code.setText(existing == null ? "" : existing.optString("code", ""));
+        CheckBox enabled = new CheckBox(activity);
+        enabled.setText("Enabled");
+        enabled.setChecked(existing == null || existing.optBoolean("enabled", true));
+        LinearLayout layout = new LinearLayout(activity);
+        layout.setOrientation(LinearLayout.VERTICAL);
+        int pad = (int) (activity.getResources().getDisplayMetrics().density * 16);
+        layout.setPadding(pad, pad, pad, 0);
+        layout.addView(name);
+        layout.addView(enabled);
+        layout.addView(code);
+        AlertDialog.Builder builder =
+                new AlertDialog.Builder(activity).setTitle("Userscript").setView(layout);
+        builder.setPositiveButton(
+                android.R.string.ok,
+                (dialog, which) -> {
+                    JSONObject script = existing == null ? new JSONObject() : existing;
+                    try {
+                        script.put("name", name.getText().toString().trim());
+                        script.put("code", code.getText().toString());
+                        script.put("enabled", enabled.isChecked());
+                        if (index < 0) scripts.put(script);
+                    } catch (JSONException ignored) {
+                        return;
+                    }
+                    writeScripts(scripts);
+                });
+        if (index >= 0) {
+            builder.setNeutralButton(
+                    "Delete",
+                    (dialog, which) -> {
+                        scripts.remove(index);
+                        writeScripts(scripts);
+                    });
+        }
+        builder.setNegativeButton(android.R.string.cancel, null).show();
+    }
+
+    private static void showCustomizeMenu(ChromeActivity activity) {
+        // The ids below are the Pomelo entries plus common overflow actions. Checked means shown.
+        int[] ids =
+                new int[] {
+                    R.id.pomelo_float_video,
+                    R.id.pomelo_media,
+                    R.id.pomelo_ad_block,
+                    R.id.pomelo_volume_scroll,
+                    R.id.pomelo_userscripts,
+                    R.id.new_tab_menu_id,
+                    R.id.new_incognito_tab_menu_id,
+                    R.id.all_bookmarks_menu_id,
+                    R.id.recent_tabs_menu_id,
+                    R.id.downloads_menu_id,
+                    R.id.open_history_menu_id,
+                    R.id.share_menu_id,
+                    R.id.find_in_page_id,
+                    R.id.translate_id,
+                    R.id.reader_mode_prefs_id,
+                    R.id.preferences_id,
+                    R.id.dev_tools,
+                    R.id.dev_tools_inspect,
+                    R.id.extensions_menu_menu_id
+                };
+        String[] titles =
+                new String[] {
+                    "Float video",
+                    "Page media",
+                    adBlockTitle(),
+                    volumeTitle(),
+                    "Userscripts",
+                    "New tab",
+                    "New Incognito tab",
+                    "Bookmarks",
+                    "Recent tabs",
+                    "Downloads",
+                    "History",
+                    "Share",
+                    "Find in page",
+                    "Translate",
+                    "Reader mode",
+                    "Settings",
+                    "Developer tools",
+                    "Inspect",
+                    "Extensions"
+                };
+        Set<String> hidden = hiddenIds();
+        boolean[] checked = new boolean[ids.length];
+        for (int i = 0; i < ids.length; i++) {
+            checked[i] = !hidden.contains(Integer.toString(ids[i]));
+        }
+        new AlertDialog.Builder(activity)
+                .setTitle("Overflow menu")
+                .setMultiChoiceItems(
+                        titles,
+                        checked,
+                        (dialog, which, isChecked) -> checked[which] = isChecked)
+                .setPositiveButton(
+                        android.R.string.ok,
+                        (dialog, which) -> {
+                            Set<String> next = new HashSet<>();
+                            for (int i = 0; i < ids.length; i++) {
+                                if (!checked[i]) next.add(Integer.toString(ids[i]));
+                            }
+                            prefs().edit().putStringSet(KEY_HIDDEN, next).apply();
+                            toast(activity, "Menu updated");
+                        })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private static Set<String> hiddenIds() {
+        Set<String> stored = prefs().getStringSet(KEY_HIDDEN, null);
+        return stored == null ? new HashSet<>() : new HashSet<>(stored);
+    }
+
+    private static JSONArray readScripts() {
+        String raw = prefs().getString(KEY_SCRIPTS, "[]");
+        if (raw == null) raw = "[]";
+        try {
+            return new JSONArray(raw);
+        } catch (JSONException e) {
+            return new JSONArray();
+        }
+    }
+
+    private static void writeScripts(JSONArray scripts) {
+        prefs().edit().putString(KEY_SCRIPTS, scripts.toString()).apply();
+    }
+
+    private static String enabledUserscriptSource() {
+        JSONArray scripts = readScripts();
+        StringBuilder builder = new StringBuilder();
+        for (int i = 0; i < scripts.length(); i++) {
+            JSONObject script = scripts.optJSONObject(i);
+            if (script == null || !script.optBoolean("enabled", true)) continue;
+            String code = script.optString("code", "");
+            if (code.isEmpty()) continue;
+            builder.append("try{")
+                    .append(code)
+                    .append("\n}catch(e){}\n");
+        }
+        return builder.toString();
+    }
+
+    private static @Nullable WebContents currentWebContents(ChromeActivity activity) {
+        Tab tab = activity.getActivityTab();
+        return tab == null ? null : tab.getWebContents();
+    }
+
+    private static void runOnPage(
+            WebContents webContents, String script, @Nullable JavaScriptCallback callback) {
+        RenderFrameHost frame = webContents.getMainFrame();
+        if (frame == null || !frame.isRenderFrameLive()) return;
+        frame.executeJavaScriptInIsolatedWorld(script, ISOLATED_WORLD_MAIN, callback);
+    }
+
+    private static void addLines(Set<String> urls, @Nullable String blob) {
+        if (blob == null || blob.isEmpty()) return;
+        for (String line : blob.split("\n")) {
+            if (!line.isEmpty()) urls.add(line);
+        }
+    }
+
+    private static void toast(Context context, String message) {
+        Toast.makeText(context, message, Toast.LENGTH_SHORT).show();
+    }
+}
