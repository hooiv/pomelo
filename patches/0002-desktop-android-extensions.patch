+  // Also override browser-initiated navigations to the store. The Java path
+  // does not see this forced exception, so the address bar would still load
+  // the mobile store layout.
+  if (navigation_handle->IsRendererInitiated() || is_web_store) {
     navigation_handle->SetIsOverridingUserAgent(desktop_mode);
   }
 
